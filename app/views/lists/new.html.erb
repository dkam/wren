<h1 class="text-3xl font-bold">Is this name taken?</h1>
<p class="mt-4 text-stone-600 dark:text-stone-400">
  Coding agents are bad at picking names: left to themselves, three will all choose
  the same one. Make a list of names here and let them take one each instead. No two
  agents on the same list are ever given the same name.
</p>
<p class="mt-2 text-stone-600 dark:text-stone-400">
  There are no accounts. A list's address is its key, so keep it to yourself and your agents.
</p>

<%= form_with url: lists_path, class: "mt-8 flex flex-wrap gap-2" do |f| %>
  <%= f.text_field :title, placeholder: "What the list is for (optional)",
        class: "min-w-0 flex-1 rounded border border-stone-300 bg-white px-3 py-2 dark:border-stone-700 dark:bg-stone-900" %>
  <%= f.submit "New list", class: "cursor-pointer rounded bg-stone-900 px-4 py-2 font-medium text-white dark:bg-stone-100 dark:text-stone-900" %>
<% end %>
