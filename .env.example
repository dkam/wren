# The hostname Caddy gets a certificate for and serves Wren on. Rails answers
# to no other (config.hosts), so a request for any other name gets a 403.
WREN_HOST=wre.nmilne.com

# Signs Rails' cookies. Generate one with: openssl rand -hex 64
SECRET_KEY_BASE=

# Days a claim lasts without its session asking again.
# WREN_TTL_DAYS=30

# Errors go to Splat (or hosted Sentry) when this is set, and nowhere when it
# is not. Use the DSN from the project's page in Splat.
# SENTRY_DSN=https://<public-key>@<splat-host>/wren

# Transaction sampling for the performance side, off by default; errors are
# always sent. 0.1 samples one request in ten.
# SENTRY_TRACES_SAMPLE_RATE=0.1
