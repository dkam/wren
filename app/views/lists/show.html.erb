<% content_for :title, @list.title.presence || "A list of names" %>
<% content_for :width, "max-w-5xl" %>
<% input = "rounded border border-stone-300 bg-white px-3 py-2 dark:border-stone-700 dark:bg-stone-900" %>
<% button = "cursor-pointer rounded bg-stone-900 px-4 py-2 font-medium text-white dark:bg-stone-100 dark:text-stone-900" %>
<% box = "flex flex-col rounded border border-stone-300 bg-white p-3 lg:h-[32rem] dark:border-stone-700 dark:bg-stone-900" %>

<%= form_with url: list_path(@list), method: :patch, class: "flex gap-2" do |f| %>
  <%= f.text_field :title, value: @list.title, placeholder: "Untitled list",
        class: "min-w-0 flex-1 border-0 bg-transparent p-0 text-3xl font-bold focus:ring-0" %>
  <%= f.submit "Rename", class: "text-sm text-stone-500 cursor-pointer" %>
<% end %>
<p class="mt-1 text-sm text-stone-500">
  The key is <code class="font-mono"><%= @list.token %></code>. Bookmark this page: the key is the only way back.
</p>

<div id="flash" class="sticky top-0 z-10"><%= render "flash", alert: flash[:alert] %></div>

<section class="mt-8">
  <h2 class="text-lg font-semibold">Held</h2>
  <% if @claims.empty? %>
    <p class="mt-2 text-stone-500">No agent holds a name yet.</p>
  <% else %>
    <ul class="mt-2 divide-y divide-stone-200 dark:divide-stone-800">
      <% @claims.each_value do |claim| %>
        <li class="flex flex-wrap items-baseline gap-x-3 py-2">
          <span class="font-medium"><%= claim.display_name %></span>
          <span class="text-xs uppercase tracking-wide <%= claim.state == "live" ? "text-emerald-600" : "text-stone-500" %>"><%= claim.state %></span>
          <span class="min-w-0 flex-1 truncate text-sm text-stone-600 dark:text-stone-400">
            <%= [claim.note, claim.host].compact_blank.join(" · ") %>
          </span>
          <span class="text-sm text-stone-500"><%= time_ago_in_words(claim.seen_at) %> ago</span>
          <%= button_to "Release", list_claim_path(@list, claim.name), method: :delete,
                class: "cursor-pointer text-sm text-red-700 dark:text-red-400" %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section class="mt-8" data-controller="picker">
  <h2 class="text-lg font-semibold">Names</h2>
  <p class="mt-1 text-sm text-stone-500">
    Agents are given the names in the first box. Take them from the catalog: click a name, or drag it across,
    or narrow the catalog by tags and take all it shows.
  </p>

  <%# The × on every name in the box submits this one form, each to its own name's address. %>
  <%= form_with url: list_names_path(@list), method: :delete, id: "remove-name" do %><% end %>

  <div class="mt-3 grid gap-4 lg:grid-cols-2">
    <div data-picker-target="dropzone" data-action="dragover->picker#over drop->picker#drop"
         class="<%= box %> data-dragging:border-dashed data-dragging:border-stone-900 dark:data-dragging:border-stone-100">
      <%= render "chosen", list: @list, claims: @claims %>
      <%= form_with url: list_names_path(@list), class: "mt-3 flex gap-2", data: { action: "turbo:submit-end->picker#added" } do |f| %>
        <%= f.text_field :names, placeholder: "Names of your own", autocomplete: "off", class: "#{input} min-w-0 flex-1 py-1 text-sm" %>
        <%= f.submit "Add", class: "#{button} py-1 text-sm" %>
      <% end %>
    </div>

    <div id="catalog" class="<%= box %>">
      <h3 class="font-medium">Catalog</h3>
      <div data-picker-target="control" hidden class="mt-2 flex flex-wrap items-start gap-2">
        <input type="search" placeholder="Search names" aria-label="Search names" autocomplete="off"
               data-picker-target="search" data-action="picker#filter" class="<%= input %> w-40 py-1 text-sm">

        <%# The tags picked are chips in the box. Typing offers the tags that match, each with how many names carry it. %>
        <div class="relative min-w-60 flex-1">
          <div data-action="click->picker#focusTags"
               class="<%= input %> flex cursor-text flex-wrap items-center gap-1 py-1 focus-within:outline-2 focus-within:outline-stone-500">
            <template data-picker-target="chipTemplate">
              <span data-picker-target="chip" class="flex items-center rounded bg-stone-900 py-0.5 pl-1.5 font-mono text-xs text-white dark:bg-stone-100 dark:text-stone-900">
                <span></span>
                <button type="button" data-action="picker#unpick" class="cursor-pointer px-1 opacity-60 hover:opacity-100">×</button>
              </span>
            </template>
            <input type="text" role="combobox" aria-label="Tags" aria-controls="tag-options" aria-expanded="false" aria-autocomplete="list"
                   placeholder="Tags" autocomplete="off" data-picker-target="tagInput"
                   data-action="focus->picker#openTags blur->picker#closeTags input->picker#searchTags keydown->picker#tagKey"
                   class="min-w-16 flex-1 bg-transparent py-0.5 text-sm outline-none">
          </div>
          <div id="tag-options" role="listbox" data-picker-target="options" hidden
               class="absolute inset-x-0 top-full z-20 mt-1 max-h-64 overflow-y-auto rounded border border-stone-300 bg-white py-1 shadow-lg dark:border-stone-700 dark:bg-stone-900">
            <% Catalog::TAGS.sort_by { |label, count| [ -count, label ] }.each do |label, count| %>
              <%= tag.div role: "option", id: "tag-#{label}", aria: { selected: false },
                    data: { tag: label, picker_target: "option", action: "mousedown->picker#hold mousemove->picker#hover click->picker#pickOption" },
                    class: "flex cursor-pointer justify-between gap-4 px-3 py-1 font-mono text-sm aria-selected:bg-stone-100 dark:aria-selected:bg-stone-800" do %>
                <span><%= label %></span><span class="text-stone-400"><%= count %></span>
              <% end %>
            <% end %>
            <p data-picker-target="noTags" hidden class="px-3 py-1 text-sm text-stone-500">No tags match.</p>
          </div>
        </div>
      </div>
      <%= form_with url: list_names_path(@list), id: "catalog-names", data: { action: "dragstart->picker#drag dragend->picker#dragged" },
            class: "mt-3 flex min-h-0 flex-1 flex-wrap content-start gap-1.5 overflow-y-auto max-lg:max-h-72
                    *:cursor-pointer *:rounded-full *:border *:border-stone-300 *:px-2.5 *:py-0.5 *:text-sm *:hover:border-stone-500 dark:*:border-stone-700 dark:*:hover:border-stone-400" do %>
        <% chosen = @list.names.pluck(:value).to_set %>
        <%# Each character's tags apart, split by |, so the picker can match tags against one at a time. %>
        <% Catalog::NAMES.each do |name, characters| %>
          <%= tag.button name.capitalize, name: "names", value: name, hidden: chosen.include?(name), draggable: true,
                title: characters.map { it.join(", ") }.join("; "), data: { tags: characters.map { it.join(" ") }.join("|") } %>
        <% end %>
      <% end %>
      <p data-picker-target="empty" hidden class="mt-3 text-sm text-stone-500">Nothing left that matches.</p>
      <div data-picker-target="control" hidden class="mt-3">
        <%= tag.button "Take all", name: "names", form: "catalog-names", data: { picker_target: "all" },
              class: "#{button} py-1 text-sm disabled:cursor-default disabled:opacity-40" %>
      </div>
    </div>
  </div>
</section>

<%# Big, since once a list has its names, copying these into agents is most of what the page is for. %>
<section id="for-agents" aria-labelledby="for-agents-title" class="mt-16">
  <% card = "rounded-lg bg-stone-900 p-5 text-stone-100 dark:ring-1 dark:ring-stone-700" %>
  <% copy = "shrink-0 cursor-pointer rounded bg-stone-100 px-4 py-2 font-semibold text-stone-900 hover:bg-white" %>
  <h2 id="for-agents-title" class="text-3xl font-bold tracking-tight sm:text-4xl">For agents</h2>
  <p class="mt-2 text-lg text-stone-600 dark:text-stone-400">
    Paste these into a shell, or an agent's instructions. Each carries the key: anyone with it can claim names and change the list.
  </p>

  <div data-controller="copy" class="<%= card %> mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
    <span class="text-xl font-semibold">The key</span>
    <code data-copy-target="source" class="font-mono text-2xl sm:text-3xl"><%= @list.token %></code>
    <button type="button" data-action="copy#copy" class="<%= copy %> ml-auto"><span data-copy-target="label" aria-live="polite">Copy</span></button>
  </div>

  <% key = %(-H "Authorization: Bearer #{@list.token}") %>
  <% [
       [ "A name for this session", "Asking again gives the same one, and keeps it.",
         %(curl -s #{key} -d session="$SESSION" --data-urlencode note="Claude Code; my-repo" #{root_url}claim) ],
       [ "One particular name", "Kept until it is released.", %(curl -s #{key} -d name=milan #{root_url}reserve) ],
       [ "Give it back", "So another session can have it.", %(curl -s #{key} -d name=milan #{root_url}release) ],
       [ "Everything, as JSON", "The names, and who holds which.", %(curl -s #{key} #{root_url}list) ]
     ].each do |title, about, command| %>
    <div data-controller="copy" class="<%= card %> mt-4">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="text-xl font-semibold"><%= title %></h3>
          <p class="text-stone-400"><%= about %></p>
        </div>
        <button type="button" data-action="copy#copy" class="<%= copy %>"><span data-copy-target="label" aria-live="polite">Copy</span></button>
      </div>
      <pre class="mt-3 whitespace-pre-wrap wrap-anywhere text-base sm:text-lg"><code data-copy-target="source"><%= command %></code></pre>
    </div>
  <% end %>
</section>
